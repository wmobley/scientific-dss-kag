DSS_PORT=8091
# Domain under domains/ (default vector-borne-disease). Chosen at server start, never per request.
DSS_DOMAIN=
# Read-only DYNAMO catalog API for `scientific-dss catalog-verify` (https, allowlisted host, no default).
# Dev catalog: https://mintdevapi.pods.portals.tapis.io/v2.0.0
DSS_CATALOG_URL=
# Local optional pgvector profile only; change before use. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-random-password
# Live catalog URLs and credentials are deliberately unset and not read by the API.

# OpenAI configuration: local/server only. Never upload .env to the public repo.
DSS_OPENAI_ENABLED=false
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint; the host must be allowlisted in settings.py.
# Default is https://api.openai.com/v1. TACC example: https://ai.tejas.tacc.utexas.edu
OPENAI_BASE_URL=
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# "chat" (portable, default) or "responses"
OPENAI_RESPONSE_API=chat

# Optional shared LLM gateway (run: scientific-dss gateway). It holds OPENAI_API_KEY, enforces the
# rate limit and call cap for every consumer. When DSS_GATEWAY_URL is set, the app sends requests
# to the gateway with DSS_GATEWAY_TOKEN instead of using OPENAI_API_KEY directly.
DSS_GATEWAY_URL=
DSS_GATEWAY_TOKEN=
DSS_LLM_RATE_PER_MINUTE=40
DSS_LLM_MAX_CALLS=

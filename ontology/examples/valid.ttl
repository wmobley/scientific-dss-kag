# Entirely synthetic teaching data. Hash is SHA256 of the exact passage.
dp:exampleEvidence a dp:Evidence ; dp:sourceId "synthetic-001" ;
    dp:sourceHash "f3c88a3f7596877e727975066c0345bb898ace88574254d6a5c2c75a3e48f1b1" ;
    dp:passage "Synthetic mosquito suitability teaching passage." ; dp:start 0 ; dp:end 48 ; dp:reviewStatus "candidate" .


@prefix dp: <https://example.org/scientific-dss/decision-pathways#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Missing provenance and pathway fields; must fail SHACL.
dp:invalidEvidence a dp:Evidence ; dp:passage "Unattributed synthetic claim" .
dp:invalidPathway a dp:DecisionPathway ; dp:objective "Choose a method" .
